{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentReviewReceipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "task_id", "input_hash", "reviewer_context", "findings", "decision"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer_context": { "enum": ["independent", "same-agent", "human", "unavailable"] },
    "findings": { "type": "array", "items": { "type": "object" } },
    "decision": { "enum": ["accepted", "rejected", "blocked"] }
  },
  "additionalProperties": false
}
