{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentPlatformRegistry",
  "type": "object",
  "required": ["schema_version", "project_id", "platforms"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "status", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["authorized", "declared", "unavailable", "revoked"] },
          "capabilities": {
            "type": "object",
            "properties": {
              "model_probe": { "type": "boolean" },
              "independent_context": { "type": "boolean" },
              "subagents": { "type": "boolean" },
              "provenance_receipt": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
