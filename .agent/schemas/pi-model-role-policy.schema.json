{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentModelRolePolicy",
  "type": "object",
  "required": ["schema_version", "policy_id", "roles", "precedence"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "policy_id": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["tier", "independence_required"],
        "properties": {
          "tier": { "enum": ["economy", "balanced", "high_reasoning"] },
          "independence_required": { "type": "boolean" },
          "allow_fallback": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "precedence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
