{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentProvenanceReceipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "platform", "session_id", "run_id", "observed_events", "observation_sha256", "signer_observer_separated"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "platform": { "enum": ["codex", "antigravity", "generic-ide"] },
    "session_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "worktree_identity": { "type": "string", "minLength": 8 },
    "observed_events": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "observation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signer_observer_separated": { "const": true },
    "observed_at": { "type": "string", "format": "date-time" },
    "observer_pid": { "type": "integer", "minimum": 1 },
    "observer_command": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
