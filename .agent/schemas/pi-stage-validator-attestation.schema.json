{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentStageValidatorAttestation",
  "type": "object",
  "required": ["schema_version", "attestation_id", "run_id", "ledger_sha256", "decision", "validator_actor_id", "nonce", "signature"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "attestation_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["accepted", "rejected", "blocked"] },
    "validator_actor_id": { "type": "string", "minLength": 3 },
    "nonce": { "type": "string", "minLength": 8 },
    "signature": { "type": "string", "minLength": 16 }
  },
  "additionalProperties": false
}
