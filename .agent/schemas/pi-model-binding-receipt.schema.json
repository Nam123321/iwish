{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentModelBindingReceipt",
  "type": "object",
  "required": ["schema_version", "binding_id", "platform_id", "role", "policy_sha256", "binding_sha256", "decision", "requested_model", "observed_model", "review_assurance", "routing_enforcement"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "binding_id": { "type": "string", "minLength": 8 },
    "platform_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["bound", "blocked"] },
    "requested_model": { "type": ["string", "null"] },
    "observed_model": { "type": ["string", "null"] },
    "model_observation": { "enum": ["host-observed", "user-declared", "unavailable"] },
    "review_assurance": { "enum": ["not-applicable", "same-session", "same-ide-fresh-task", "isolated-subagent", "separate-host"] },
    "routing_enforcement": { "enum": ["native-hard", "native-hard-when-supported", "user-selected"] },
    "reason": { "type": "string" },
    "reasoning": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
