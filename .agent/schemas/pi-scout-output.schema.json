{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentScoutOutput",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "working_set", "checker_candidates", "read_only", "input_hash"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "working_set": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "checker_candidates": { "type": "array", "items": { "type": "object" } },
    "read_only": { "const": true },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
