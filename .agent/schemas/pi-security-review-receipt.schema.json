{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentSecurityReviewReceipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "task_id", "reviewer_role", "independent_context", "findings", "decision"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "reviewer_role": { "enum": ["security", "domain"] },
    "independent_context": { "type": "boolean" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "decision": { "enum": ["accepted", "rejected", "blocked"] }
  },
  "additionalProperties": false
}
