{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentLease",
  "type": "object",
  "required": ["schema_version", "lease_id", "run_id", "task_id", "worktree_identity", "state", "expires_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "lease_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "worktree_identity": { "type": "string", "minLength": 8 },
    "state": { "enum": ["active", "released", "expired"] },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
