{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentExecutionReceipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "run_id", "task_id", "plan_sha256", "diff_sha256", "tool_events", "diagnostics", "tests", "reviewer_decisions", "validator_decision", "redactions"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_events": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "tests": { "type": "array", "items": { "type": "object" } },
    "reviewer_decisions": { "type": "array", "items": { "type": "object" } },
    "validator_decision": { "enum": ["accepted", "rejected", "blocked"] },
    "redactions": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
