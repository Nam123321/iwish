{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentValidatorAttestation",
  "type": "object",
  "required": ["schema_version", "attestation_id", "run_id", "task_id", "worker_receipt_sha256", "review_receipt_sha256", "decision", "validator_actor_id", "nonce"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "attestation_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "minLength": 1 },
    "worker_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["accepted", "rejected", "blocked"] },
    "validator_actor_id": { "type": "string", "minLength": 3 },
    "nonce": { "type": "string", "minLength": 8 }
  },
  "additionalProperties": false
}
