{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContractIntermediateRepresentation",
  "description": "Standardized Contract Intermediate Representation (IR) for I-Wish SDLC Anti-Drift Architecture",
  "type": "object",
  "required": [
    "contractId",
    "version",
    "kind",
    "digest",
    "entities",
    "operations"
  ],
  "properties": {
    "contractId": {
      "type": "string",
      "description": "Unique identifier for this contract, e.g. 'prisma-database', 'story-10.10-manifest'"
    },
    "version": {
      "type": "string",
      "description": "Semantic or epoch version of the contract, e.g. '1.0.0', 'epoch-145'"
    },
    "kind": {
      "type": "string",
      "enum": ["database", "http", "event", "composite"],
      "description": "The category of interface contract"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Canonical SHA-256 hash of the normalized contract content"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "sourceFile": { "type": "string" },
        "generatedAt": { "type": "string" },
        "generator": { "type": "string" }
      },
      "additionalProperties": true
    },
    "enums": {
      "type": "object",
      "description": "Map of enum name to enum definition",
      "additionalProperties": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "object",
      "description": "Map of entity/model name to entity definition",
      "additionalProperties": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "description": { "type": "string" },
          "attributes": {
            "type": "array",
            "description": "Entity-level attributes (e.g. @@index, @@unique, @@map)",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "args": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "raw": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "fields": {
            "type": "object",
            "description": "Map of field name to field definition",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "isArray": { "type": "boolean", "default": false },
                "isOptional": { "type": "boolean", "default": false },
                "isId": { "type": "boolean", "default": false },
                "isUnique": { "type": "boolean", "default": false },
                "defaultValue": { "type": "string" },
                "attributes": {
                  "type": "array",
                  "description": "Field-level attributes (e.g. @id, @default, @unique, @map)",
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string" },
                      "args": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "relation": {
                  "type": "object",
                  "description": "Foreign key / relational mapping details (FMEA EC-P4-01)",
                  "properties": {
                    "targetEntity": { "type": "string" },
                    "fields": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "references": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "onDelete": { "type": "string" },
                    "onUpdate": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "object",
      "description": "Map of operation/route/event name to operation definition",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["query", "mutation", "subscription", "event", "endpoint"]
          },
          "path": { "type": "string" },
          "method": { "type": "string" },
          "input": { "type": "object" },
          "output": { "type": "object" },
          "mutates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "consumes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
