{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentCleanseReceipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "input_hash", "ruleset_hash", "findings", "decision"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ruleset_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "decision": { "enum": ["clean", "quarantined", "blocked"] }
  },
  "additionalProperties": false
}
