{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiCodeAgentTaskLedger",
  "type": "object",
  "required": ["schema_version", "run_id", "repository_id", "worktree_id", "tasks", "committed_receipt_ids"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "repository_id": { "type": "string", "minLength": 8 },
    "worktree_id": { "type": "string", "minLength": 8 },
    "tasks": { "type": "object", "minProperties": 1 },
    "committed_receipt_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
